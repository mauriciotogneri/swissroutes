{"type":"Feature","id":4496,"geometry":{"type":"Point","coordinates":[46.25425167381427,7.530372364432032]},"properties":{"land":null,"category":"all","language":"en","title":"Pumptrack du Lavioz","abstract":"This pump track blends seamlessly into the Lavioz playground. It’s ideal for children who want to improve and learn to pump on a bike, skateboard or scooter. It consists of three bends, a jump and various asphalt bumps. With a bit of imagination, it’s even possible to try out a few transfers. This facility can even be used by small children with balance bikes. More experienced riders can build up confidence here before hitting the Sigeroulaz flow trail.","description":"","highlights":null,"foto":"https://images.schweizmobil.ch/image-big/Pumptrack_du_Lavioz_1_g.jpg","foto_urls":null,"foto_abstract":null,"photo_gallery":["https://images.schweizmobil.ch/image/Pumptrack_du_Lavioz_1_s.jpg","https://images.schweizmobil.ch/image/Pumptrack_du_Lavioz_2_s.jpg","https://images.schweizmobil.ch/image/Pumptrack_du_Lavioz_3_s.jpg"],"photo_gallery_big":["https://images.schweizmobil.ch/image-big/Pumptrack_du_Lavioz_1_g.jpg","https://images.schweizmobil.ch/image-big/Pumptrack_du_Lavioz_2_g.jpg","https://images.schweizmobil.ch/image-big/Pumptrack_du_Lavioz_3_g.jpg"],"photo_gallery_copyright":["","",""],"photo_gallery_author":["","",""],"photo_gallery_abstract":["","",""],"name":"Vercorin Tourisme SA","name_2":null,"street":"Route d’Anniviers 7","zip":"3967","place":"Vercorin","tel":"+41 (0)27 455 58 55","fax":null,"email":"info@vercorin.ch","url1_link":"https://www.vercorin.ch","x_coordinate":607074.8606516997,"y_coordinate":122540.56820911556,"change_date":null,"id":4496,"r_key":4496,"type":"Sight","url_sightseeing":"https://www.valais.ch/en/explore/activities/mountain-bike/pumptracks-skillsparks/pumptrack-du-lavioz","touristic_region":11,"canton":7,"canonical":null,"content_provider":null,"st_identifier":null}}